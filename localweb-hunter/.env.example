# LocalWeb Hunter — 環境変数サンプル
# cp .env.example .env.local してから値を埋めること。.env.local はコミットしない。
# APIキーはすべてサーバーサイドでのみ読む。NEXT_PUBLIC_ を付けたキーは
# クライアントバンドルに埋め込まれるので、APIキーには絶対に付けないこと（§4-3）。
#
# ★ 何も設定しなくてもアプリは起動し、モックデータで全機能を試せる。
#   有料APIを一切叩かない状態から始められる設計にしてある。

# ============================================================
# 予算ガード（§2-1）— 超過したら例外を投げて外部API呼び出しを停止する
# ============================================================
MONTHLY_BUDGET_USD=5
# 1回の検索で使ってよい上限。暴走時の被害を月予算より手前で止める。
PER_SEARCH_BUDGET_USD=1

# ============================================================
# ビジネスデータプロバイダ（§3-2）
#   mock       … サンプルデータ。$0。キー不要。デフォルト。
#   osm        … OpenStreetMap Overpass API。$0。ただし評価・レビュー件数を持たない。
#   dataforseo … 本番。$0.012/req + $0.00036/件（2026年7月値上げ後）。要 login/password。
# ============================================================
BUSINESS_DATA_PROVIDER=mock

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# 実装時に https://dataforseo.com/pricing/business-data/business-listings-api で
# 現在の単価を確認して上書きすること（単価は変わり得る）。
DATAFORSEO_COST_PER_REQUEST=0.012
DATAFORSEO_COST_PER_ITEM=0.00036

# OSM Overpass のエンドポイント（公共サーバーに負荷をかけないよう間隔を空けて叩く）
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# モックプロバイダが配信する店舗サイトのURL。
# これがあると、Phase 2（サイト品質の実測・公開メールの抽出）をモックのまま
# 実際のコードで動かせる。メールアドレスが一覧に出るのを確認できる。
# ★ npm run dev / start のポートを変えた場合はここも合わせること。
#   ホスト名は localhost ではなく 127.0.0.1 を使う（理由は src/config/env.ts のコメント参照）。
MOCK_SITE_BASE_URL=http://127.0.0.1:3000

# ============================================================
# 検索プロバイダ（Phase 2 Stage 2 — 公式サイト候補の探索）
#
#   none       … Web検索を行わない。$0。キー不要のデフォルト。
#                Stage 2 をスキップするので「HPなし」判定の精度は落ちる。
#
#   dataforseo … ★有料で使うならこれが最適。$0.002/クエリ（Live）。
#                Business Listings と同じ認証情報を使うので追加設定は不要。
#                アカウントも請求も予算ガードも1つで済む。
#                柏市で通過180件なら約$0.36。
#
#   google     … ⚠️ 新規申込停止中。2027年1月1日でサービス終了予定。既存契約者のみ。
#   brave      … ⚠️ 2026年2月に新規向け無料プランが廃止。約$4〜5/1,000クエリ。
#                DataForSEO SERP より高く、別アカウント・別請求になる。
#
# 詳細は docs/DECISIONS.md §7 を参照。
# ============================================================
SEARCH_PROVIDER=none

# DataForSEO SERP を使う場合の設定（DATAFORSEO_LOGIN/PASSWORD は上の設定を共用）
# 単価は https://dataforseo.com/pricing/google-serp/google-organic-serp-api で確認すること
DATAFORSEO_SERP_COST_PER_QUERY=0.002
DATAFORSEO_SERP_LOCATION=Japan
DATAFORSEO_SERP_LANGUAGE=ja
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_API_KEY=

# ============================================================
# AIプロバイダ（§9）
#   heuristic … AIを使わないルールベース版。$0。キー不要。デフォルト。
#   gemini / openai / anthropic … 実API。
# ============================================================
AI_PROVIDER=heuristic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# 1件あたりのAI推定コスト（コストダッシュボードの試算用。実測に合わせて調整する）
AI_COST_PER_BUSINESS=0.0005

# ============================================================
# クローラ（§2-2）— 変更する場合も、間隔を短くしすぎないこと
# ============================================================
# 同一ドメインへの最小リクエスト間隔（ミリ秒）。2000未満にはしない。
CRAWLER_MIN_INTERVAL_MS=2000
CRAWLER_TIMEOUT_MS=10000
CRAWLER_MAX_RETRIES=2
# User-Agent には識別子と連絡先URLを必ず含める。自分の連絡先に書き換えること。
CRAWLER_USER_AGENT=LocalWebHunter/0.2 (+https://example.com/about)
# 1店舗あたりクロールしてよいページ数の上限
CRAWLER_MAX_PAGES_PER_SITE=5

# ============================================================
# ストレージ
#   sqlite   … ローカルファイル。デフォルト。アカウント不要。
#   supabase … Supabase (PostgreSQL)。
#   ★ supabase は未実装。指定すると起動時にエラーになります。
# ============================================================
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/localweb-hunter.db

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# レート制限（§4-3）
# ============================================================
# 1時間あたりに実行できる検索の回数
SEARCH_RATE_LIMIT_PER_HOUR=20
