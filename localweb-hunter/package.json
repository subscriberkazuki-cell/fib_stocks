{
  "name": "localweb-hunter",
  "version": "0.2.0",
  "private": true,
  "description": "評価は高いがWebプレゼンスが弱い地域店舗を発掘し、HP制作営業の見込み客リストと優先順位を生成するローカル実行ツール",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "node scripts/init-db.mjs",
    "db:reset": "node scripts/init-db.mjs --reset",
    "check:dataforseo": "node scripts/test-dataforseo-search.mjs",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "22.15.3",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-next": "^15.5.25",
    "playwright": "^1.56.1",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "3.1.2"
  }
}
